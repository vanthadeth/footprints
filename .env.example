VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MAP_PROVIDER=
VITE_MAP_API_KEY=

# If your hosting provider won't let you set/overwrite the two Supabase
# vars above (e.g. they collide with a var already managed by another
# integration), set these instead -- the app falls back to them.
# VITE_SUPABASE_URL_2=
# VITE_SUPABASE_ANON_KEY_2=

# Never put SUPABASE_SERVICE_ROLE_KEY in a VITE_-prefixed variable or
# anywhere else reachable from frontend code. It must only exist in
# server-side contexts (e.g. a Supabase Edge Function), never in this app.
